// Firestore 보안 규칙 — Firebase 콘솔과 반드시 동기화할 것.
// ⚠️ 이 파일을 수정하면 Firebase 콘솔(Firestore → 규칙)에도 붙여넣고 "게시"해야 적용된다.
//    콘솔에만 고치고 여기 반영 안 하면(또는 반대) 코드-규칙 불일치로 조용한 쓰기 실패가 생긴다
//    — 2026-07-17 wbsHistory 이력 0건 사건의 직접 원인이 이 불일치였음.
// 새 컬렉션을 코드에 도입할 때는 같은 커밋에서 이 파일에 규칙을 추가할 것.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 예외 허용 계정 — index.html의 EXTRA_ACCOUNTS와 반드시 함께 유지
    function isAllowedEmail() {
      return request.auth != null && (
        request.auth.token.email.matches('.*@sejong-21c[.]com$')
        || request.auth.token.email == 'hkaiedu@naver.com'
      );
    }
    function isCompanyUser() {
      return isAllowedEmail();
    }
    // 부서장 이상(부장님 지시 2026-09-18) — 전사 공지에 글을 올릴 수 있는 사람.
    // 등급은 플랫폼과 같은 users.grade 를 쓴다. 지금 쓰이는 값: super·exec·manager·member.
    function isDeptHeadOrAbove() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.grade in ['super', 'exec', 'manager'];
    }

    match /users/{userId} {
      allow read: if isCompanyUser();
      allow create: if request.auth != null && request.auth.uid == userId
                    && isAllowedEmail();
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.grade == 'super'
      );
      allow delete: if request.auth != null
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.grade == 'super';
    }
    match /userState/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid
                        && isAllowedEmail();
    }
    match /pendingUsers/{docId} {
      allow read, write: if isCompanyUser();
    }

    match /channels/{channelId} {
      allow read, create, update: if isCompanyUser();
      allow delete: if false;
    }
    // 전사 공지 채널 — **readers 를 박지 않는다**
    // ⚠️ 이름이 영문인 이유: 규칙 언어는 한글 식별자를 못 읽는다(에뮬레이터가 2026-09-21 에 잡았다).(읽을사람() 이 announce 에 null 을 준다).
    // 아래 create 규칙의 목록과 반드시 같이 움직여야 한다. 공지 채널이 늘면 두 곳을 같이 고칠 것.
    function noticeChannels() { return ['c1']; }

    match /messages/{messageId} {
      // **2단계**: 내가 읽어도 되는 메시지만 읽는다(2026-09-21).
      // 그전에는 `isCompanyUser()` 하나였다 — 사내 계정이면 **남의 1:1 대화까지 전부** 읽혔고,
      // 화면이 가려 줄 뿐이라 개발자 도구로는 그냥 보였다. 읽기 비용도 여기서 나왔다
      // (메신저 부팅 한 번이 전체 messages 500건이었다).
      //
      // readers 는 보낼 때 박고(b46), 옛 메시지는 백필로 채웠다(scripts/readers-backfill-night.mjs).
      // **백필 전에 이 규칙을 올리면 모두가 옛 대화를 통째로 잃는다** — 순서가 곧 안전장치다.
      //
      // 목록 조회는 규칙이 문서마다 걸리므로, 클라이언트가
      // `where('readers','array-contains', 내uid)` 로 좁혀야만 열린다. 통째로 훑기는 여기서 막힌다.
      allow read: if isCompanyUser() && (
        request.auth.uid in resource.data.get('readers', [])
        || resource.data.channel in noticeChannels()
      );
      // 일반 사용자 발송: author = 본인 uid
      // 전사 공지(c1)만 부서장 이상. 채널 비교가 앞이라 평소 메시지에는 users 조회가 일어나지 않는다(읽기 비용 0).
      //   화면(messenger.js)에서도 입력창을 접지만, 그것만으로는 개발자 도구로 그냥 쓸 수 있어 여기서도 막는다.
      //   공지 채널이 늘어나면 이 목록에 id 를 추가할 것 — 지금은 c1 하나다(2026-09-18 실측).
      // 시스템 알림: author = 'SYSTEM' + system: true + 지정된 시스템 채널로만 (검교정 임박 알림 등)
      allow create: if isCompanyUser() && (
        (request.resource.data.author == request.auth.uid
         && (!(request.resource.data.channel in noticeChannels()) || isDeptHeadOrAbove()))
        ||
        (request.resource.data.author == 'SYSTEM'
         && request.resource.data.system == true
         && request.resource.data.channel in ['qa-calibration-alert'])
      );
      allow update: if false;
      allow delete: if isCompanyUser() && resource.data.author == request.auth.uid;
    }
    match /channelReads/{readId} {
      allow read: if isCompanyUser();
      allow write: if isCompanyUser() && request.resource.data.uid == request.auth.uid;
    }

    match /projects/{pid}                { allow read, write: if isCompanyUser(); }
    match /wbsData/{pid}                 { allow read, write: if isCompanyUser(); }
    match /wbsPending/{docId}            { allow read, write: if isCompanyUser(); }
    match /wbsHistory/{docId}            { allow read, write: if isCompanyUser(); }
    // v29.36: 워크오더 자동등록 마커 — localStorage 대신 서버가 "등록됨"의 진실 (WBS 덮어쓰기 사고 재발 방지)
    match /woRegistry/{docId}            { allow read, write: if isCompanyUser(); }
    // v29.37: Traveller 검사 실적(REC) 서버 저장 — wbsRec/{pid}_{itemId}
    match /wbsRec/{docId}                { allow read, write: if isCompanyUser(); }

    // v28.4.48: WBS 조회 전용 공유 — 링크를 아는 사람은 로그인 없이 read 가능(외부 공유용).
    // 쓰기(공유 생성·갱신)는 사내 계정만. 스냅샷 복사본이라 원본 wbsData는 계속 보호됨.
    match /wbsShares/{shareId} {
      allow read: if true;
      allow write: if isCompanyUser();
    }

    match /tasks/{tid}                   { allow read, write: if isCompanyUser(); }
    match /events/{docId}                { allow read, write: if isCompanyUser(); }
    match /okrs/{docId}                  { allow read, write: if isCompanyUser(); }
    match /approvals/{docId}             { allow read, write: if isCompanyUser(); }
    match /ncrs/{docId}                  { allow read, write: if isCompanyUser(); }
    match /ncrDeleteReqs/{docId}         { allow read, write: if isCompanyUser(); }
    match /cars/{docId}                  { allow read, write: if isCompanyUser(); }
    match /carDeleteReqs/{docId}         { allow read, write: if isCompanyUser(); }
    match /measurementTools/{toolId}     { allow read, write: if isCompanyUser(); }
    match /measurementCheckouts/{coId}   { allow read, write: if isCompanyUser(); }
    // v1.0 회의 모듈 — 회의실 예약 + 회의록 (전 직원 읽기·쓰기)
    match /meetingReservations/{docId}   { allow read, write: if isCompanyUser(); }
    match /meetingMinutes/{docId}        { allow read, write: if isCompanyUser(); }
    // v29.43: AI 비서 사용 기록 — 질문 1건당 1문서(로그). 생성만 허용, 수정·삭제 불가(감사 로그 성격)
    match /aiUsage/{docId}               { allow read, create: if isCompanyUser(); allow update, delete: if false; }
    // v3.9(2026-09-23) 게이트웨이 장부: 하루·한 사람당 한 줄. **브라우저는 못 쓴다.**
    //   쓸 수 있으면 자기 횟수를 0 으로 되돌릴 수 있어 한도가 장식이 된다.
    //   게이트웨이는 서비스 계정으로 쓰므로 규칙을 우회한다 — 여기를 닫아도 기록은 남는다.
    //   이름에 t_ 를 안 붙인 이유: 맨 아래 catch-all 이 `^t_.*` 를 전부 열어 준다.
    match /aiUsageDaily/{docId}          { allow read: if isCompanyUser(); allow write: if false; }
    // v4.1(2026-09-23) 맡긴 개인 API 열쇠: **아무도 읽지도 쓰지도 못한다.**
    //   게이트웨이만 서비스 계정으로 오간다. 잠가 두긴 했지만(AES-GCM) 읽는 길 자체를 없앤다 —
    //   등록은 /key/set, 확인은 /key/status(끝 네 자리만), 돌려주는 길은 만들지 않았다.
    match /aiUserKeys/{docId}            { allow read, write: if false; }
    // v30.19(2026-09-23) 읽기 장부: 그날 브라우저들이 문서를 몇 건 읽었나. **계량기지 통제가 아니다** —
    //   직원 브라우저가 스스로 올려야 하므로 만들기·고치기를 연다. 지우기는 막는다(하루치가 통째로 날아간다).
    //   틀린 값을 넣어 봤자 제 눈을 가리는 것뿐이고, 여기 없으면 한도를 또 모르고 태운다.
    match /readDaily/{docId}             { allow read, create, update: if isCompanyUser(); allow delete: if false; }
    // v29.44: 관리 탭 기록들 — 오류·접속·작업 로그. 생성만 허용, 수정·삭제 불가
    match /errorLog/{docId}              { allow read, create: if isCompanyUser(); allow update, delete: if false; }
    match /accessLog/{docId}             { allow read, create: if isCompanyUser(); allow update, delete: if false; }
    match /activityLog/{docId}           { allow read, create: if isCompanyUser(); allow update, delete: if false; }
    // v29.44: 관리 탭 접근 지정자 명단 — 읽기는 사내 전체(메뉴 노출 판단용), 쓰기는 대표(super)만
    match /adminAccess/{docId} {
      allow read: if isCompanyUser();
      allow write: if isCompanyUser()
                   && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.grade == 'super';
    }

    // ── 품질기록 변경 이력 (ISO 9001 7.5.3) — 2026-09-20 ──────────────────────
    // 왜: NCR·CAR 을 고치면 그냥 덮어써서 "누가 언제 무엇을 바꿨나" 가 어디에도 없었다.
    //     외부 심사에서 물으면 답할 자료가 없다. 업계 eQMS 기준은 기록이 **변조가 드러나야**
    //     한다고 본다 — 변경은 조용히 덮는 게 아니라 기록된다.
    //
    // **필드 이름은 아스키다.** 규칙 언어가 한글 필드 이름을 못 읽는다 — `data.누가` 를 쓰면
    // 규칙 전체가 컴파일 실패한다(2026-09-20, 시험대가 운영에 올리기 전에 잡았다).
    // 값은 한국어여도 된다(그냥 문자열이다).
    //
    // **덧붙이기 전용.** 만들 수만 있고 고치거나 지울 수 없다. 이게 이 컬렉션의 전부다.
    // 남의 이름으로 못 쓴다(누가 == 본인). 아래 범용 t_ 규칙보다 **먼저** 와야 하고,
    // 거기서 이 컬렉션을 빼야 실제로 걸린다(Firestore 는 어느 한 규칙이 허용하면 통과한다).
    match /t_recordLog/{logId} {
      allow read: if isCompanyUser();
      allow create: if isCompanyUser()
                    && request.resource.data.by == request.auth.uid
                    && request.resource.data.coll is string
                    && request.resource.data.recId is string
                    && request.resource.data.act in ['만듦', '고침', '지움'];
      allow update, delete: if false;
    }

    // 품질기록 본체 — **판(버전)이 반드시 커져야 저장된다.**
    // 판을 안 올리면 거부되므로 "조용한 덮어쓰기" 가 구조적으로 불가능해진다.
    // 옛 기록에는 판이 없다 — get('판', 0) 으로 0 으로 보고, 첫 저장 때 1 이 된다(백필 불필요).
    // 지우기는 여전히 허용한다. 삭제 표시로 바꾸는 것은 화면을 같이 고쳐야 해서 다음 단계다
    // (지울 때도 화면이 이력을 먼저 남긴다 — audit.mjs 남기기('지움')).
    match /t_ncrs/{docId} {
      allow read: if isCompanyUser();
      allow create: if isCompanyUser();
      allow update: if isCompanyUser() && request.resource.data.rev is int
                    && request.resource.data.rev > resource.data.get('rev', 0);
      allow delete: if isCompanyUser();
    }
    match /t_cars/{docId} {
      allow read: if isCompanyUser();
      allow create: if isCompanyUser();
      allow update: if isCompanyUser() && request.resource.data.rev is int
                    && request.resource.data.rev > resource.data.get('rev', 0);
      allow delete: if isCompanyUser();
    }

    // SJ 메신저 프로필(사진·전화) — 본인만 쓴다. users 문서를 무겁게 하지 않으려고 따로 둔 컬렉션.
    // 아래 범용 t_ 규칙에서 이 컬렉션은 빼야 "본인만" 이 실제로 걸린다(Firestore 는 어느 한 규칙이 허용하면 통과).
    match /t_userProfile/{uid} {
      allow read: if isCompanyUser();
      allow write: if isCompanyUser() && request.auth.uid == uid;
    }
    // SJ 메신저 AI 비서 대화 — 본인 것만 읽고 쓴다.
    // messages 에 넣지 않은 이유: 메신저는 전 직원이 최근 메시지를 통째로 구독한다(남의 AI 대화가 모두의 폰에 내려간다).
    // 목록 조회는 where('uid','==',나) 로 들어와야 통과한다 — 클라이언트(messenger.js 구독)가 그렇게 부른다.
    match /t_aiChat/{docId} {
      allow read: if isCompanyUser() && resource.data.uid == request.auth.uid;
      allow create: if isCompanyUser() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isCompanyUser() && resource.data.uid == request.auth.uid;
    }
    match /{col}/{docId} {
      // **여기서 빼야 위 규칙이 실제로 걸린다.** Firestore 는 어느 한 규칙이 허용하면 통과한다 —
      // t_ncrs·t_cars·t_recordLog 가 여기 남아 있으면 판 강제도 덧붙이기 전용도 아무 소용이 없다.
      allow read, write: if isCompanyUser() && col.matches('^t_.*')
                         && col != 't_userProfile' && col != 't_aiChat'
                         && col != 't_recordLog' && col != 't_ncrs' && col != 't_cars';
    }
  }
}
